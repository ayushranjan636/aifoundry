# AI Foundry — Environment Configuration
# Copy this file to .env and fill in your values

# ──── Frontend (Vite) ────────────────────────────────────────
# AI engine key for browser-side inference (optional — backend handles it in production)
VITE_OPENAI_API_KEY=sk-your-key-here

# Backend API URL — set to your Railway deployed URL in production
# VITE_API_URL=https://your-backend.railway.app

# ──── Backend (Server) ───────────────────────────────────────
# Port (Railway provides this automatically)
# PORT=3001

# OpenAI key for server-side inference (same key works)
OPENAI_API_KEY=sk-your-key-here
